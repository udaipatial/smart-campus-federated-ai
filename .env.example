# Copy to .env and fill in real values. Never commit .env.

# ── Backend: FastAPI on a Python host (e.g. Render) ────────────────────────
# Comma-separated, EXACT origins allowed to call this API cross-origin.
# In production this must be the deployed frontend origin, e.g.
#   ALLOWED_ORIGINS=https://your-frontend.vercel.app
# Add every origin you actually use (custom domain, preview domain), separated
# by commas. Leave unset for local development: loopback origins are then
# allowed automatically and the UI served by FastAPI needs no CORS at all.
ALLOWED_ORIGINS=

# ── Frontend: static site on Vercel ────────────────────────────────────────
# Base URL of the FastAPI backend, without a trailing slash, e.g.
#   VITE_API_BASE_URL=https://your-backend.onrender.com
# Leave unset for local development, where FastAPI serves the UI itself
# (same-origin). Set this in the Vercel project's environment variables, not
# in a committed file.
VITE_API_BASE_URL=
